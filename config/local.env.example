# Valores propios de este equipo. Copiar a config/local.env (ignorado por git) y ajustar.
# `./install.sh check --sugerir` propone los valores detectados. Valores de ejemplo ficticios.

# Usuarios: el principal (escritorio de uso diario) y el de pruebas (banco de pruebas de cada cambio)
MAIN_USER="usuario"
TEST_USER="pruebas"

# Color de acento de GNOME: blue (por defecto), teal, green, yellow, orange, red, pink, purple o slate
ACCENT_COLOR="blue"

# Arranque (capa boot, opt-in): ESP de Fedora (montada en /boot/efi) y ESP de Windows, por PARTUUID,
# y número de la entrada de Fedora en el firmware (efibootmgr), respaldo de rEFInd
FEDORA_ESP_PARTUUID="00000000-0000-0000-0000-000000000000"
WINDOWS_ESP_PARTUUID="11111111-1111-1111-1111-111111111111"
FEDORA_BOOTNUM="0000"

# Solo para el escaneo de datos personales (hook de pre-commit y CI local): nunca se usan en los scripts.
# Listas separadas por espacios.
MONITOR_SERIALS="SERIE1 SERIE2"
PERSONAL_EMAILS=""   # tus correos (cuentas, git), separados por espacios
LOCAL_IPS="192.0.2.10"
SECRET_LITERALS="contraseña-de-ejemplo"
