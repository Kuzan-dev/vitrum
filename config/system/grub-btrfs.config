#!/usr/bin/env bash
# Configuración de grub-btrfs para Fedora. Se instala en /etc/default/grub-btrfs/config.
# Solo se definen las claves que difieren del valor por defecto de v4.14.

# Título del submenú en GRUB
GRUB_BTRFS_SUBMENUNAME="Fedora snapshots"

# Máximo de snapshots en el submenú (se cuentan tras aplicar los filtros). grub-btrfs no permite fijar un
# snapshot: muestra los N más recientes. Con 10, los snapshots manuales (sin limpieza automática) desplazaban
# a root-pre-fase1, el más antiguo. 30 deja margen; los «pre-capa-*» del instalador usan limpieza «number».
GRUB_BTRFS_LIMIT="30"

# Solo snapshots "pre" de Snapper (estado ANTES de cada transacción dnf), además de
# los "single" ("base fase 1") y los que no son de Snapper (root-pre-fase1).
# Visibles: los de Snapper con limpieza «number» (≤ 10, sin los «post») + los manuales + base + root-pre-fase1.
GRUB_BTRFS_IGNORE_SNAPSHOT_TYPE=("post")

# Valores por defecto de v4.14 (se mantienen explícitos)
GRUB_BTRFS_IGNORE_SPECIFIC_PATH=("@")
GRUB_BTRFS_IGNORE_PREFIX_PATH=("var/lib/docker" "@var/lib/docker" "@/var/lib/docker" "var/lib/containers" "@var/lib/containers" "@/var/lib/containers")

# Rutas de Fedora (grub2)
GRUB_BTRFS_GRUB_DIRNAME="/boot/grub2"
GRUB_BTRFS_BOOT_DIRNAME="/boot"
GRUB_BTRFS_MKCONFIG=/usr/bin/grub2-mkconfig
GRUB_BTRFS_SCRIPT_CHECK=grub2-script-check
# En Fedora 44 está en /usr/share/grub/ (no en /usr/share/grub2/ como sugiere el ejemplo)
GRUB_BTRFS_MKCONFIG_LIB=/usr/share/grub/grub-mkconfig_lib

# GRUB_BTRFS_GBTRFS_DIRNAME NO se define aquí: grub-btrfs-regen lo apunta a un
# directorio temporal para generar grub-btrfs.cfg y luego renombrarlo de forma atómica.
