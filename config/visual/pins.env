# --- Waywallen (experimento de fondo animado, docs/capas.md) ---
# Flatpak de usuario desde un remoto Flathub --user (el del sistema sigue filtrado). Fijado por commit
# OSTree (hash criptográfico) y bloqueado con `flatpak mask`: sin actualizaciones automáticas.
WAYWALLEN_FLATPAK_APP="org.waywallen.waywallen"
WAYWALLEN_FLATPAK_VERSION="0.4.4"
WAYWALLEN_FLATPAK_COMMIT="872cb80fa5f8a5e648cb8edd8df02b43f39010564bc946a6b26a59fd7cac008b"
# Extensión de GNOME (waywallen-display, protocolo de pantalla v9 = el del daemon 0.4.4). El JS del zip
# coincide con el tag v0.4.2; lib/ trae una biblioteca nativa que solo carga el proceso renderizador.
WAYWALLEN_GNOME_UUID="org.waywallen.gnome@waywallen.io"
WAYWALLEN_GNOME_URL="https://github.com/waywallen/waywallen-display/releases/download/v0.4.2/waywallen-gnome-0.4.2-x86_64.zip"
WAYWALLEN_GNOME_SHA256="8ccf5ad07e7750aa27489198cffcab2daf104f9e2f742ab45bfe5417337df4af"
# Plugin open-wallpaper-engine (escenas y web de Wallpaper Engine). El Lua coincide con el tag v0.3.0;
# los renderizadores (escenas Vulkan y CEF/Chromium) son binarios precompilados que corren dentro del
# sandbox del Flatpak, sin red. spawn_version 10 = el del daemon 0.4.4.
WAYWALLEN_OWE_ID="org.waywallen.open-wallpaper-engine"
WAYWALLEN_OWE_URL="https://github.com/waywallen/open-wallpaper-engine/releases/download/v0.3.0/org.waywallen.open-wallpaper-engine-0.3.0-linux-x86_64.zip"
