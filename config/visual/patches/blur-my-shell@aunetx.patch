+// Parche local (dotfiles): el desenfoque estático solo ve el fondo de pantalla. Se añaden clones
+// de las ventanas visibles que tocan este monitor (en orden de apilamiento), dentro de un contenedor
+// del tamaño del monitor que recorta lo que sobresale: un clon fuera de esos límites agrandaba el
+// fondo desenfocado y el desenfoque salía nítido o desplazado (dock sin cristal cuando había una
+// ventana en el otro monitor). Así el desenfoque muestra lo que hay realmente detrás y conserva las
+// esquinas del efecto 'corner'. Se clonan
+// ventanas sueltas (como la vista general), no global.window_group (eso colgaba la sesión), y
+// nunca ventanas a pantalla completa (un clon impediría el "unredirect" de los juegos).
+class GGWindowClones {
+    constructor(container, monitor) {
+        this._container = container;
+        this._monitor = monitor;
+        this._clones = [];
+        this._ids = [];
+        this._idle = 0;
+        this._holder = new Clutter.Actor({
+            x: 0, y: 0, width: monitor.width, height: monitor.height, clip_to_allocation: true,
+        });
+        container.add_child(this._holder);
+        const watch = (obj, signal) => this._ids.push([obj, obj.connect(signal, () => this._queue())]);
+        watch(global.display, 'window-entered-monitor');
+        watch(global.display, 'window-left-monitor');
+        watch(global.display, 'grab-op-end');
+        watch(global.display, 'restacked');
+        watch(global.display, 'in-fullscreen-changed');
+        watch(global.workspace_manager, 'active-workspace-changed');
+        watch(global.window_manager, 'minimize');
+        watch(global.window_manager, 'unminimize');
+        watch(global.window_manager, 'map');
+        watch(global.window_manager, 'destroy');
+        watch(global.window_manager, 'size-changed');
+        this._rebuild();
+    }
+
+    _queue() {
+        if (this._idle)
+            return;
+        this._idle = GLib.idle_add(GLib.PRIORITY_DEFAULT_IDLE, () => {
+            this._idle = 0;
+            this._rebuild();
+            return GLib.SOURCE_REMOVE;
+        });
+    }
+
+    _rebuild() {
+        this._clones.forEach(clone => clone.destroy());
+        this._clones = [];
+        const workspace = global.workspace_manager.get_active_workspace();
+        for (const actor of global.get_window_actors()) {
+            const win = actor.get_meta_window();
+            if (!win || win.minimized || win.is_fullscreen() ||
+                !win.located_on_workspace(workspace) ||
+                !win.showing_on_its_workspace())
+                continue;
+            const r = win.get_frame_rect();
+            const m = this._monitor;
+            if (r.x >= m.x + m.width || r.x + r.width <= m.x ||
+                r.y >= m.y + m.height || r.y + r.height <= m.y)
+                continue;
+            const clone = new Clutter.Clone({source: actor});
+            clone.add_constraint(new Clutter.BindConstraint({
+                source: actor, coordinate: Clutter.BindCoordinate.X, offset: -this._monitor.x,
+            }));
+            clone.add_constraint(new Clutter.BindConstraint({
+                source: actor, coordinate: Clutter.BindCoordinate.Y, offset: -this._monitor.y,
+            }));
+            this._holder.add_child(clone);
+            this._clones.push(clone);
+        }
+        this._container.queue_redraw();
+    }
+
+    destroy() {
+        this._ids.forEach(([obj, id]) => obj.disconnect(id));
+        this._ids = [];
+        if (this._idle)
+            GLib.source_remove(this._idle);
+        this._idle = 0;
+        this._clones = [];
+    }
+}
