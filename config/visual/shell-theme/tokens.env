# Tokens de diseño del tema de shell GoldenGate (fase 3, paso 1).
# El CSS de GNOME Shell (St) no admite variables CSS: scripts/visual.sh (paso shell-theme)
# sustituye cada @NOMBRE@ de GoldenGate/gnome-shell/gnome-shell.css.in por estos valores
# y aborta si queda algún marcador sin resolver. Para afinar: cambiar aquí y reinstalar.

# Superficies (menús, Control Center, calendario, avisos, OSD, diálogos)
SURFACE="rgba(30, 30, 32, 0.92)"
BORDER="1px solid rgba(255, 255, 255, 0.06)"
SHADOW="0 2px 12px 0 rgba(0, 0, 0, 0.14)"

# Cápsulas de la barra superior: sin fondo en reposo, fondo solo al interactuar
CAPSULE_BG="transparent"
CAPSULE_BG_HOVER="rgba(255, 255, 255, 0.14)"
CAPSULE_BG_ACTIVE="rgba(255, 255, 255, 0.20)"
# Fondo de la cápsula propia de la bandeja (variante «propia» de tray/variant)
TRAY_CAPSULE_BG="rgba(255, 255, 255, 0.08)"

# Radios
RADIUS_CAPSULE="999px"
RADIUS_MENU="22px"
RADIUS_TILE="16px"
RADIUS_ITEM="12px"

# Rejilla (múltiplos de 4 px)
SPACE_XS="4px"
SPACE_S="8px"
SPACE_M="12px"
SPACE_L="16px"

# Tipografía: Adwaita Sans (Inter de GNOME, la fuente del sistema); 400 texto, 600 barra/títulos
WEIGHT_STRONG="600"

# Barra y dock con desenfoque (variantes en config/visual/glass/)
DOCK_BORDER="1px solid rgba(255, 255, 255, 0.12)"
PANEL_TEXT_SHADOW="0 1px 2px rgba(0, 0, 0, 0.35)"
